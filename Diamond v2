#include <stdio.h>

int main() {
 //top to middle
    int n = 3;
    int i = 1;
    while(i <=n){
    int spaces = 0;
        while(spaces < n - i){ 
            printf(" ");
            spaces++;
        }
        int h = 0;
        while(h < 2*i -1){
        printf("*");
        h++;
    }
        printf("\n");
        i++;
    }
   //bottom to middle
    i= n - 1;

    while(i>= 1){
    int spaces = 0;
        while(spaces < n - i){ 
            printf(" ");
            spaces++;
        }
        int h=0;
        while(h < 2*i -1){
        printf("*");
        h++;
    }
        printf("\n");
        i--;
    }
    return 0;
}
